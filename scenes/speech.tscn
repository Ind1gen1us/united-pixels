[sub_resource type="GDScript" id="GDScript_f58mw"]
resource_name = "record_indicator"
script/source = "extends Sprite2D

var shader_material := preload(\"res://shaders/outline.gdshader\")
var default_material
var shader_applied:= false
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	default_material = material

func apply_shader() -> void:
	if not shader_applied:
		default_material.shader = shader_material
	else:
		default_material.shader = null
	shader_applied = not shader_applied
"

[sub_resource type="AudioStreamMicrophone" id="AudioStreamMicrophone_bajkm"]

[sub_resource type="GDScript" id="GDScript_x0gc8"]
resource_name = "mic_indicator"
script/source = "extends Entity

signal is_speaking(flag: bool)
var is_recording: bool = false
@onready var audio_manager = $\"../AudioHandling\"

func _ready() -> void:
	super._ready()
	# Enable selection so shader can be applied
	can_be_selected = true

## Overriden method to maintain recording color during hover
func _on_button_mouse_entered() -> void:
	is_hovered = true
	if not is_recording:
		apply_shader()  # appling base color only if not recording

## Overriden method to restore recording color when mouse exits during recording
func _on_button_mouse_exited() -> void:
	is_hovered = false
	if is_recording:
		apply_shader(pressed_outline_color)  # keep recording color
	else:
		remove_shader()  # removing shader if not recording

## Override to prevent color change on release
func _on_button_button_up() -> void:
	if is_recording and is_hovered:
		apply_shader(pressed_outline_color)  # Restore recording color if still hovering

## Toggle recording state and apply/remove shader accordingly
func _on_button_button_down() -> void:
	is_recording = not is_recording
	
	if is_recording:
		print(name, \" recording started\")
		apply_shader(pressed_outline_color)  # Show outline when recording
		start_recording()
	else:
		print(name, \" recording stopped\")
		if is_hovered:
			apply_shader()  # Show hover color if still hovering
		else:
			remove_shader()  # Remove outline when not recording
		stop_recording()

## Start recording functionality
func start_recording() -> void:
	is_speaking.emit(true) # playing speaking animation in the Speaker node
	audio_manager.start_recording()


## Stop recording functionality
func stop_recording() -> void:
	is_speaking.emit(false) # stoping the animation

"

