[sub_resource type="GDScript" id="GDScript_gbyw3"]
resource_name = "assembly_cam"
script/source = "extends Camera2D
@export var shake_offset: Vector2
@export var shake_duration: float = 0.1

func shake() ->void: # camera shaking effect
	var shake_tween = create_tween()
	shake_tween.tween_property(self, \"offset\",shake_offset, shake_duration)
	shake_tween.tween_property(self, \"offset\", -shake_offset, shake_duration)
	shake_tween.tween_property(self, \"offset\", Vector2.ZERO, shake_duration)
	
"

[sub_resource type="GDScript" id="GDScript_xb7ms"]
resource_name = "podium"
script/source = "extends Entity

var speaker_sprite := preload(\"res://scenes/entities/delegate_player.tres\")
var data_to_pass: Dictionary = { \"speaker\": speaker_sprite
}
func _ready() -> void:
	super._ready() # check base class
	
func _on_button_pressed() -> void:
		#changing to the speech scene when the bodium is clicked
		SceneManager.change_scene(\"speech\", true, data_to_pass)
"

